function drawRain(){
ctx.strokeStyle=
"rgba(180,195,215,.17)";
ctx.lineWidth=1;
for(const drop of rain){
drop.y+=drop.speed;
if(drop.y>H+20){
drop.y=-20;
drop.x=Math.random()*W;
}
ctx.beginPath();
ctx.moveTo(
drop.x,
drop.y
);
ctx.lineTo(
drop.x-3,
drop.y+drop.length
);
ctx.stroke();
}
}
